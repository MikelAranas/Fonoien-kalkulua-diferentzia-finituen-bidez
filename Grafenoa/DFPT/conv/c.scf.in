&CONTROL
  calculation   = 'vc-relax',
  prefix        = 'graphene',
  outdir        = './tmp',
  pseudo_dir    = './',
  forc_conv_thr = 1.0d-4,
  etot_conv_thr = 1.0d-5,
/
&SYSTEM
  ibrav     = 0,
  nat       = 2,
  ntyp      = 1,
  ecutwfc   = 100.0,
  occupations = 'smearing',
  smearing    = 'mv',
  degauss     = 0.02,
  assume_isolated = '2D'
/
&ELECTRONS
  mixing_beta = 0.7,
  conv_thr    = 1.0d-9,
/
&IONS
  ion_dynamics = 'bfgs',
/
&CELL
  cell_dynamics = 'bfgs',
  cell_dofree   = 'xy',
/
ATOMIC_SPECIES
  C  12.0107  C.upf

