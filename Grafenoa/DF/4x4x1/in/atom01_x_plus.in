&CONTROL
  calculation = 'scf'
  prefix = 'graphene_sup'
  outdir      = './tmp/'
  pseudo_dir = '../../../pseudopotentzialak/'
  tprnfor     = .true.
/
&SYSTEM
  ibrav           = 0
  nat             = 32
  ntyp            = 1
  ecutwfc         = 100.0
  occupations     = 'smearing'
  smearing        = 'mv'
  degauss         = 0.02
  assume_isolated = '2D'
/
&ELECTRONS
  mixing_beta = 0.7
  conv_thr    = 1.0d-16
/
