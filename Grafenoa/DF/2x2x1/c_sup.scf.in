&CONTROL
  calculation = 'scf'
  prefix      = 'graphene_sup'
  outdir      = './tmp/'
  pseudo_dir = '../../../pseudopotentzialak/'
  tprnfor     = .true.
/
&SYSTEM
  ibrav           = 0
  nat             = 8
  ntyp            = 1
  ecutwfc         = 100.0
  occupations     = 'smearing'
  smearing        = 'mv'
  degauss         = 0.02
  assume_isolated = '2D'
/
&ELECTRONS
  mixing_beta = 0.7
  conv_thr    = 1.0d-16
/
ATOMIC_SPECIES
  C  12.0107 C.upf

CELL_PARAMETERS angstrom
   4.9306500000   0.0000000000   0.0000000000
  -2.4653250000   4.2700681572   0.0000000000
   0.0000000000   0.0000000000  17.8000000000

ATOMIC_POSITIONS crystal
C   0.000000   0.000000   0.500000
C   0.166667   0.333333   0.500000
C   0.500000   0.000000   0.500000
C   0.666667   0.333333   0.500000
C   0.000000   0.500000   0.500000
C   0.166667   0.833333   0.500000
C   0.500000   0.500000   0.500000
C   0.666667   0.833333   0.500000

K_POINTS automatic
