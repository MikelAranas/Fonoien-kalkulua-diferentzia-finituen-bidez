&CONTROL
  calculation = 'scf',
  restart_mode = 'from_scratch',
  prefix = 'al',
  pseudo_dir = '../../../pseudopotentzialak/',
  outdir = './tmp',
  verbosity = 'high',
  tprnfor = .true.,
  tstress = .true.
/
&SYSTEM
  ibrav = 0,
  nat = 64,
  ntyp = 1,
  ecutwfc = 50,
  occupations = 'smearing',
  smearing = 'mp'
  degauss = 0.02
/
&ELECTRONS
  conv_thr = 1.0d-16
/
ATOMIC_SPECIES
Al 26.9815 Al.upf

