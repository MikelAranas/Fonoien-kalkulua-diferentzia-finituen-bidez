&CONTROL
calculation = 'scf',
restart_mode = 'from_scratch',
prefix = 'al',
pseudo_dir = '../../../pseudopotentzialak/',
outdir ='./tmp',
verbosity = 'high'
tprnfor = .true.,
tstress = .true.
/
&SYSTEM
ibrav = 0,
nat = 8,
ntyp = 1,
ecutwfc = 50,
occupations = 'smearing',
smearing = 'mp'
degauss = 0.02
/
&ELECTRONS
conv_thr = 1.0d-16

/
ATOMIC_SPECIES
Al 26.9815 Al.upf

CELL_PARAMETERS angstrom
  -4.0378  0.0000  4.0378
  0.0000  4.0378  4.0378   
  -4.0378  4.0378  0.0000

ATOMIC_POSITIONS angstrom
Al 0.000000 -0.010000 0.000000
Al -2.018900 0.000000 2.018900
Al 0.000000 2.018900 2.018900
Al -2.018900 2.018900 4.037800
Al -2.018900 2.018900 0.000000
Al -4.037800 2.018900 2.018900
Al -2.018900 4.037800 2.018900
Al -4.037800 4.037800 4.037800

K_POINTS (automatic)
12 12 12 0 0 0

