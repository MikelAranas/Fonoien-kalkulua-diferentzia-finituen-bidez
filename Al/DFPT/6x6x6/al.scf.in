&CONTROL
calculation = 'scf',
restart_mode = 'from_scratch',
prefix = 'al',
pseudo_dir = '../../../pseudopotentzialak/',
outdir ='./tmp',
verbosity = 'high'
tprnfor = .true.
/
&SYSTEM
ibrav = 0,
nat = 1,
ntyp = 1,
ecutwfc = 50,
occupations = 'smearing',
smearing = 'mp'
degauss = 0.02
/
&ELECTRONS
conv_thr = 1.0d-16

/
ATOMIC_SPECIES
Al 26.9815 Al.upf

CELL_PARAMETERS (angstrom)
  -2.018900000   0.000000000   2.018900000
   0.000000000   2.018900000   2.018900000
  -2.018900000   2.018900000   0.000000000


ATOMIC_POSITIONS angstrom
Al 0.00 0.00 0.00
 
K_POINTS (automatic)
24 24 24 0 0 0
