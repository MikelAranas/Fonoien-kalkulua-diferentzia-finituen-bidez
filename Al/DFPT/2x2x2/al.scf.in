&CONTROL
calculation = 'scf',
restart_mode = 'from_scratch',
prefix = 'al',
pseudo_dir = '../../../pseudopotentzialak/',
outdir ='./tmp',
verbosity = 'high'
tprnfor = .true.
/
&SYSTEM
ibrav = 0,
nat = 1,
ntyp = 1,
ecutwfc = 38,
ecutrho = 80,
occupations = 'smearing',
smearing = 'mp'
degauss = 0.02
/
&ELECTRONS
conv_thr = 1.0d-16

/
ATOMIC_SPECIES
Al 26.9815 Al.upf

CELL_PARAMETERS angstrom
  -2.0189  0.0000  2.0189
  0.0000  2.0189  2.0189
  -2.0189  2.0189  0.0000


ATOMIC_POSITIONS angstrom
Al 0.00 0.00 0.00
 
K_POINTS (automatic)
12 12 12 1 1 1
